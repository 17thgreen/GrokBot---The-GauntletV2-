      "semantics": {
        "candle": "1-minute candlestick; end_period_ts is the CLOSE of the minute bar",
        "obs_time": "set to candle end_period_ts (ISO)",
        "decision_time": "CLOSE - time_remaining_sec; for mid path equals obs_time (exact minute grid)",
        "knowability": "A trader knows the candle's close values only at/after the minute end. Using end_period_ts as decision_time is therefore decision-time-aligned for that closed bar \u2014 not lookahead into a future bar. At exact OPEN there is no closed 1m candle yet.",
        "mid_construction": "mid = (yes_bid.close + yes_ask.close)/2 from the closed minute bar at decision_time"
      }
